# Канал сессий Atrice: доступ только группе agent, только этот порт.
# Правило узкое намеренно: совпадение идёт по имени одного порта, остальные
# устройства virtio-ports прав не меняют. TAG+="systemd" нужен, чтобы у порта
# появился device-юнит и служба могла дождаться его.
SUBSYSTEM=="virtio-ports", ATTR{name}=="atrice.control", GROUP="agent", MODE="0660", TAG+="systemd"
