# Порт прямого входа в сессию Atrice: доступ только группе agent, только этот
# порт. Правило узкое намеренно: совпадение идёт по имени одного порта, и
# остальные устройства virtio-ports прав не меняют. TAG+="systemd" нужен,
# чтобы у порта появился device-юнит и служба могла дождаться его.
SUBSYSTEM=="virtio-ports", ATTR{name}=="atrice.session", GROUP="agent", MODE="0660", TAG+="systemd"
